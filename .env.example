# File purpose:
# - Environment variables for the local-first AX4LAB runtime
#
# Key classes/functions:
# - N/A
#
# Inputs/outputs:
# - Input: values loaded by python-dotenv
# - Output: runtime configuration for API keys and endpoints
#
# Dependencies:
# - app.bootstrap.load_runtime
#
# Modification guide:
# - Safe places to edit: values and endpoint strings
# - Risky places to edit: key names used by code modules
# - Related files: configs/system.yaml, knowledge/rag.py, backends/ollama_client.py

# Backend selection:
# - Loading the API key in the GUI enables OpenAI as the first inference route.
# - Unloading it restores the selected local backend, without deleting the key.
# - A saved disabled key stays disabled after restart; key presence is not readiness.
# Public CLI/server choices are vllm (local endpoint) and openai (API endpoint).
# Ollama/NemoClaw adapters are library-only, not selectable runtime backends.
AX4LAB_BACKEND=vllm
# Role selections refer to registered endpoint IDs in runtime/configs/system.yaml.
# Served model names and capabilities are properties of those endpoints.
# Registered endpoint URLs are authoritative; edit them in configuration or GUI.
# OPENAI_BASE_URL/VLLM_BASE_URL below do not retarget registered endpoint records.
AUTONOMOUS_VLLM_ORCHESTRATOR_ENDPOINT=local-main
AUTONOMOUS_VLLM_WORKER_ENDPOINT=local-main
AUTONOMOUS_OPENAI_ORCHESTRATOR_ENDPOINT=api-main
AUTONOMOUS_OPENAI_WORKER_ENDPOINT=api-main
AUTONOMOUS_MODULE_DESIGNER_MODEL=
AUTONOMOUS_USE_REAL_LLM_IN_TEST=1
AUTONOMOUS_ALLOW_MOCK_FALLBACK=0
AUTONOMOUS_PLANNING_TIMEOUT_S=600
AUTONOMOUS_PLANNING_PRIMARY_TIMEOUT_S=240

# API key names stay here as blank placeholders only.
# Put real values in .env, or document local-only key handling in
# docs/runtime/api_keys.local.md. See system/runtime/api_keys.md.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_S=300
OPENAI_REASONING_EFFORT=
OPENAI_TEMPERATURE=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

NEMOCLAW_PROXY_URL=http://127.0.0.1:11435
NEMOCLAW_TOKEN_FILE=~/.nemoclaw/ollama-proxy-token
NEMOCLAW_AUTO_START_PROXY=1
# Absolute local proxy script path; required only when proxy auto-start is enabled.
NEMOCLAW_PROXY_SCRIPT=
NEMOCLAW_PROXY_PORT=11435
NEMOCLAW_BACKEND_PORT=11434
NEMOCLAW_TIMEOUT_S=300
NEMOCLAW_KEEP_ALIVE=0

AX4LAB_HOST=127.0.0.1
AX4LAB_PORT=7861
# Optional explicit API target for ax4lab and checkpoint clients (not server bind).
# If blank, URL derives from AX4LAB_HOST/PORT, then configs/system.yaml.
AX4LAB_URL=
# AUTONOMOUS_* runtime/model controls and ATR_* integration keys below are
# compatibility protocol names, not aliases for the old atr launcher.
AUTONOMOUS_RELOAD=1
AUTONOMOUS_WORKERS=1

# Optional Knowledge graph mirror. Keep the real password only in ignored .env.
ATR_KNOWLEDGE_GRAPH_ENABLED=0
ATR_KNOWLEDGE_EVENT_PIPELINE_ENABLED=0
ATR_KNOWLEDGE_GRAPH_BACKEND=neo4j
ATR_KNOWLEDGE_GRAPH_FAIL_OPEN=1
ATR_NEO4J_URI=bolt://127.0.0.1:17687
ATR_NEO4J_USERNAME=neo4j
ATR_NEO4J_PASSWORD=
ATR_NEO4J_DATABASE=neo4j
ATR_KNOWLEDGE_GRAPH_MAX_ATTEMPTS=5

# Optional internet RAG providers
TAVILY_API_KEY=
SERPER_API_KEY=

# Logging
LOG_DIR=./runs/logs
